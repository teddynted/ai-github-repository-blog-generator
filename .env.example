# GitHub AI Blog Generator — example environment configuration.
#
# Copy to .env for local development. In AWS, these values are injected into
# each Lambda by CloudFormation. NEVER put GitHub PATs or webhook secrets in
# here — those live only in AWS Secrets Manager.

# --- Core ---
AWS_REGION=us-east-1
LOG_LEVEL=info

# --- Publishing trigger (platform default; per-repo override lives in metadata) ---
PUBLISH_TRIGGER=blog:

# --- Data stores ---
REPOSITORIES_TABLE=blog-gen-repositories
# Shared secret holding ALL repositories' credentials as JSON keyed by
# "<owner>/<name>". Name or ARN; set by CloudFormation in AWS.
REPO_SECRET_ID=blog-gen/github/repositories

# --- Event plumbing ---
EVENT_BUS_NAME=blog-gen-bus
QUEUE_URL=

# --- Registration (webhook-handler resolves this per-repo; registration uses it
# --- to create the GitHub webhook). Set by CloudFormation in AWS. ---
WEBHOOK_URL=

# --- Compute lifecycle ---
# INSTANCE_ID is the On-Demand host the scheduler powers on/off (scheduled-start
# / scheduled-stop). Instance power is a fixed weekday window (18:00–20:00,
# Mon–Fri) set on the scheduler stack — there is no idle timeout.
INSTANCE_ID=
N8N_WEBHOOK_URL=

# --- AI (local inference) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Per-request inference timeout (Go duration). Long-form generation on CPU can
# take many minutes; raise this if blog generation aborts with "context
# deadline exceeded". Defaults to 15m.
OLLAMA_TIMEOUT=15m

# --- Worker filesystem (on the instance /data is the EBS volume) ---
OUTPUT_DIR=/data/generated-content
WORK_DIR=/data/work
MEMORY_DIR=/data/memory

# --- Optional: publish to S3 instead of local files (set OUTPUT_S3_BUCKET) ---
OUTPUT_S3_BUCKET=
OUTPUT_S3_PREFIX=generated-content

# --- Publishing / approval ---
REQUIRE_HUMAN_APPROVAL=false
PENDING_DIR=/data/pending

# --- Notifications (optional; blank = log only) ---
NOTIFY_WEBHOOK_URL=
# Email via Turbo SMTP. From/To enable it; recipients comma-separated. Sending
# also requires SMTP_USERNAME + SMTP_PASSWORD. Keep SMTP_PASSWORD out of source
# control (prefer AWS Secrets Manager at deploy time).
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587
SMTP_USERNAME=
# Provide the password ONE of two ways:
#   SMTP_PASSWORD        - plaintext (local/dev only)
#   SMTP_PASSWORD_SECRET - AWS Secrets Manager id/ARN, resolved at startup
#                          (preferred in AWS; wins over SMTP_PASSWORD)
SMTP_PASSWORD=
SMTP_PASSWORD_SECRET=
