# GitHub AI Blog Generator — example environment configuration.
#
# Copy to .env for local development. In AWS, these values are injected into
# each Lambda by CloudFormation. NEVER put GitHub PATs or webhook secrets in
# here — those live only in AWS Secrets Manager.

# --- Core ---
AWS_REGION=us-east-1
LOG_LEVEL=info

# --- Publishing trigger (platform default; per-repo override lives in metadata) ---
PUBLISH_TRIGGER=blog:

# --- Data stores ---
REPOSITORIES_TABLE=blog-gen-repositories
SECRETS_PREFIX=blog-gen/repos

# --- Event plumbing ---
EVENT_BUS_NAME=blog-gen-bus
QUEUE_URL=

# --- Registration (webhook-handler resolves this per-repo; registration uses it
# --- to create the GitHub webhook). Set by CloudFormation in AWS. ---
WEBHOOK_URL=

# --- Compute lifecycle ---
INSTANCE_ID=
N8N_WEBHOOK_URL=
IDLE_TIMEOUT_MINUTES=15

# --- AI (local inference) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- Content output (worker writes generated Markdown here; /data is the EBS volume) ---
OUTPUT_DIR=/data/generated-content

# --- Publishing ---
REQUIRE_HUMAN_APPROVAL=false
